{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rox-appointment-booking/booking-panel",
	"title": "Rox Appointment Booking Panel",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Displays the booking panel on the page, or as a button that opens it in a popup.",
	"textdomain": "rox-appointment-booking",
	"keywords": ["booking", "appointment", "panel", "button", "popup", "rox"],
	"supports": {
		"html": false
	},
	"attributes": {
		"displayMode": { "type": "string", "default": "general" },
		"hideNavigation": { "type": "boolean", "default": false },
		"hideInfo": { "type": "boolean", "default": false },
		"serviceColumns": { "type": "number", "default": 2 },
		"showDashboardButton": { "type": "boolean", "default": true },
		"dashboardButtonText": { "type": "string", "default": "" },
		"dashboardButtonUrl": { "type": "string", "default": "" },
		"headingAlign": { "type": "string", "default": "" },
		"headingMargin": { "type": "object", "default": {} },
		"contentMargin": { "type": "object", "default": {} },
		"panelContent": { "type": "object", "default": {} },
		"showBackground": { "type": "boolean", "default": true },
		"backgroundColor": { "type": "string", "default": "" },
		"accentColor": { "type": "string", "default": "" },
		"fontFamily": { "type": "string", "default": "" },
		"locationIds": { "type": "array", "default": [], "items": { "type": "number" } },
		"categoryIds": { "type": "array", "default": [], "items": { "type": "number" } },
		"navBackBgColor": { "type": "string", "default": "" },
		"navBackTextColor": { "type": "string", "default": "" },
		"navBackBorderColor": { "type": "string", "default": "" },
		"navBackBgColorHover": { "type": "string", "default": "" },
		"navBackTextColorHover": { "type": "string", "default": "" },
		"navBackBorderColorHover": { "type": "string", "default": "" },
		"navBackPadding": { "type": "object", "default": {} },
		"navBackMargin": { "type": "object", "default": {} },
		"navBackBorderStyle": { "type": "string", "default": "" },
		"navBackBorderWidth": { "type": ["number", "null"], "default": null },
		"navBackBorderRadius": { "type": ["number", "null"], "default": null },
		"navBackFontSize": { "type": ["number", "null"], "default": null },
		"navBackFontWeight": { "type": "string", "default": "" },
		"navNextBgColor": { "type": "string", "default": "" },
		"navNextTextColor": { "type": "string", "default": "" },
		"navNextBorderColor": { "type": "string", "default": "" },
		"navNextBgColorHover": { "type": "string", "default": "" },
		"navNextTextColorHover": { "type": "string", "default": "" },
		"navNextBorderColorHover": { "type": "string", "default": "" },
		"navNextPadding": { "type": "object", "default": {} },
		"navNextMargin": { "type": "object", "default": {} },
		"navNextBorderStyle": { "type": "string", "default": "" },
		"navNextBorderWidth": { "type": ["number", "null"], "default": null },
		"navNextBorderRadius": { "type": ["number", "null"], "default": null },
		"navNextFontSize": { "type": ["number", "null"], "default": null },
		"navNextFontWeight": { "type": "string", "default": "" },
		"buttonText": { "type": "string", "default": "Book Appointment" },
		"buttonAlign": { "type": "string", "default": "left" },
		"buttonAlignTablet": { "type": "string", "default": "" },
		"buttonAlignMobile": { "type": "string", "default": "" },
		"buttonWidth": { "type": "string", "default": "auto" },
		"buttonSize": { "type": "string", "default": "medium" },
		"buttonStyle": { "type": "string", "default": "filled" },
		"buttonIcon": { "type": "string", "default": "calendar" },
		"buttonBackgroundColor": { "type": "string", "default": "#3560fb" },
		"buttonTextColor": { "type": "string", "default": "#ffffff" },
		"buttonBorderColor": { "type": "string", "default": "" },
		"buttonBackgroundColorHover": { "type": "string", "default": "" },
		"buttonTextColorHover": { "type": "string", "default": "" },
		"buttonBorderColorHover": { "type": "string", "default": "" },
		"buttonFillColor": { "type": "string", "default": "" },
		"buttonFillColorHover": { "type": "string", "default": "" },
		"buttonBorderWidth": { "type": "number", "default": 1 },
		"buttonBorderWidthTablet": { "type": ["number", "null"], "default": null },
		"buttonBorderWidthMobile": { "type": ["number", "null"], "default": null },
		"buttonBorderWidthHover": { "type": ["number", "null"], "default": null },
		"buttonBorderStyle": { "type": "string", "default": "solid" },
		"buttonBorderRadius": { "type": "number", "default": 6 },
		"buttonBorderRadiusTablet": { "type": ["number", "null"], "default": null },
		"buttonBorderRadiusMobile": { "type": ["number", "null"], "default": null },
		"buttonPadding": { "type": "object", "default": {} },
		"buttonPaddingTablet": { "type": "object", "default": {} },
		"buttonPaddingMobile": { "type": "object", "default": {} },
		"buttonMargin": { "type": "object", "default": {} },
		"buttonMarginTablet": { "type": "object", "default": {} },
		"buttonMarginMobile": { "type": "object", "default": {} },
		"buttonWidthSize": { "type": ["number", "null"], "default": null },
		"buttonWidthSizeTablet": { "type": ["number", "null"], "default": null },
		"buttonWidthSizeMobile": { "type": ["number", "null"], "default": null },
		"buttonIconSize": { "type": ["number", "null"], "default": null },
		"buttonIconSizeTablet": { "type": ["number", "null"], "default": null },
		"buttonIconSizeMobile": { "type": ["number", "null"], "default": null },
		"buttonIconGap": { "type": ["number", "null"], "default": null },
		"buttonIconGapTablet": { "type": ["number", "null"], "default": null },
		"buttonIconGapMobile": { "type": ["number", "null"], "default": null },
		"buttonIconOffsetY": { "type": ["number", "null"], "default": null },
		"buttonIconOffsetYTablet": { "type": ["number", "null"], "default": null },
		"buttonIconOffsetYMobile": { "type": ["number", "null"], "default": null },
		"buttonBoxShadow": { "type": "object", "default": {} },
		"buttonBoxShadowHover": { "type": "object", "default": {} },
		"modalWidth": { "type": "number", "default": 1100 },
		"resetOnClose": { "type": "boolean", "default": false }
	},
	"editorScript": "rox-appointment-booking-booking-panel-editor",
	"editorStyle": "rox-appointment-booking-booking-panel-editor-style",
	"viewScript": "rox-appointment-booking-frontend",
	"viewStyle": "rox-appointment-booking-frontend"
}
